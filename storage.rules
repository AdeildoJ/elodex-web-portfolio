rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /npcs/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /missionsEvents/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /scenarios/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /badges/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Capas dos pacotes da loja (aparecem no app). Leitura pública; gravação só admin.
    match /storePackages/{packageId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Avatar e assets do jogador: só o próprio usuário pode gravar em seu path
    match /players/{userId}/characters/{characterId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
