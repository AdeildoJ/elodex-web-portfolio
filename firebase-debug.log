[debug] [2026-03-03T20:08:34.074Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/elodex-1c8a1/rulesets {"name":"projects/elodex-1c8a1/rulesets/8c4bf6c1-cfbf-4647-a0d3-0d19d028743c","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // ================================\n    // ðŸ”§ Helpers\n    // ================================\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isSelf(uid) {\n      return request.auth != null && request.auth.uid == uid;\n    }\n\n    function isAdmin() {\n      return request.auth != null && request.auth.token.admin == true;\n    }\n\n    // ================================\n    // ðŸ”¥ POKÃ‰DEX ADMIN\n    // ================================\n\n    // EspÃ©cies base dos PokÃ©mon (Biblioteca)\n    match /pokemonSpecies/{id} {\n      allow read:  if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    // ConfiguraÃ§Ãµes mutÃ¡veis de venda dos itens (loja)\n    match /itemsConfig/{id} {\n      allow read:  if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    // ConfiguraÃ§Ãµes por versÃ£o do jogo\n    match /pokedexConfig/{id} {\n      allow read:  if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    // Configuracao de encontros por bioma (definida no Pokedex/Admin)\n    match /biomeEncounterConfig/{id} {\n      allow read: if isSignedIn();\n      allow write: if isAdmin();\n\n      // Subcolecoes por bioma: /groups e /individual\n      match /{document=**} {\n        allow read: if isSignedIn();\n        allow write: if isAdmin();\n      }\n    }\n\n    // Grupos de captura (configuracao coletiva)\n    match /captureConfigGroups/{id} {\n      allow read: if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    // Movimentos (catÃ¡logo geral de golpes)\n    match /moves/{id} {\n      allow read:  if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    // Learnset por espÃ©cie\n    match /pokemonMoves/{id} {\n      allow read:  if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    // Habilidades\n    match /abilities/{id} {\n      allow read:  if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    // Itens globais (CatÃ¡logo)\n    match /items/{id} {\n      allow read:  if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    // ================================\n    // ðŸ”¥ ELODEX â€” USUÃRIOS\n    // ================================\n\n    // Perfil e dados do app mobile\n    match /players/{uid} {\n      allow read:  if isSelf(uid) || isAdmin();\n      allow write: if isSelf(uid) || isAdmin();\n\n      // Todas as subcolecoes: characters, box, time, itens, pokeballs, etc.\n      match /{document=**} {\n        allow read:  if isSelf(uid) || isAdmin();\n        allow write: if isSelf(uid) || isAdmin();\n      }\n    }\n\n    match /users/{uid} {\n      allow read:  if isSelf(uid) || isAdmin();\n      allow write: if isSelf(uid) || isAdmin();\n    }\n\n    // HistÃ³rico financeiro principal (por usuÃ¡rio)\n    match /users/{uid}/transactions/{txId} {\n      allow read:  if isSelf(uid) || isAdmin();\n      allow write: if isSelf(uid) || isAdmin();\n    }\n\n    // âœ… collectionGroup(transactions) para admin\n    match /{path=**}/transactions/{txId} {\n      allow read: if isAdmin();\n    }\n\n    // Time principal\n    match /users/{uid}/team/{slotId} {\n      allow read:  if isSelf(uid) || isAdmin();\n      allow write: if isSelf(uid) || isAdmin();\n    }\n\n    // Box de armazenamento\n    match /users/{uid}/box/{boxEntryId} {\n      allow read:  if isSelf(uid) || isAdmin();\n      allow write: if isSelf(uid) || isAdmin();\n    }\n\n    // InventÃ¡rio de itens do jogador\n    match /users/{uid}/inventory/{itemId} {\n      allow read:  if isSelf(uid) || isAdmin();\n      allow write: if isSelf(uid) || isAdmin();\n    }\n\n    // HistÃ³rico econÃ´mico\n    match /users/{uid}/economy/{eventId} {\n      allow read:  if isSelf(uid) || isAdmin();\n      allow write: if isSelf(uid) || isAdmin();\n    }\n\n    // HistÃ³rico por PokÃ©mon\n    match /users/{uid}/pokemonHistory/{histId} {\n      allow read:  if isSelf(uid) || isAdmin();\n      allow write: if isSelf(uid) || isAdmin();\n    }\n\n    // ================================\n    // ðŸ”¥ INSTÃ‚NCIAS DE POKÃ‰MON\n    // ================================\n    match /pokemonInstances/{pokeInstanceId} {\n      allow read: if (isSignedIn() && isSelf(resource.data.ownerId)) || isAdmin();\n      allow write: if (isSignedIn() && isSelf(request.resource.data.ownerId)) || isAdmin();\n    }\n\n    // ================================\n    // ðŸ”¥ ESTATÃSTICAS\n    // ================================\n    match /users_stats/{uid} {\n      allow read:  if isSelf(uid) || isAdmin();\n      allow write: if isSelf(uid) || isAdmin();\n    }\n\n    match /pokemon_stats/{pokeId} {\n      allow read:  if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    // ================================\n    // ðŸ”¥ LOGS / MISSÃ•ES / EVENTOS\n    // ================================\n\n    match /encounters_log/{id} {\n      allow read:  if false;\n      allow write: if isSignedIn();\n    }\n\n    // âœ… CONFIGURAÃ‡ÃƒO ADMIN (NOVO) â€” MissÃµes & Eventos (Admin)\n    // ColeÃ§Ã£o unificada apenas para CONFIGURAÃ‡ÃƒO\n    // (nÃ£o Ã© execuÃ§Ã£o de jogo)\n    match /missionsEvents/{id} {\n      allow read:  if isAdmin();\n      allow write: if isAdmin();\n    }\n\n    // ColeÃ§Ãµes antigas (se vocÃª ainda usa em algum lugar)\n    match /missions/{id} {\n      allow read:  if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    match /events/{id} {\n      allow read:  if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    match /audit_logs/{id} {\n      allow read:  if isAdmin();\n      allow write: if isAdmin();\n    }\n\n    // ================================\n    // ðŸ”¥ PRESENÃ‡A (futuro)\n    // ================================\n    match /presence/{uid} {\n      allow read:  if isSignedIn();\n      allow write: if false;\n    }\n  }\n}\n\r\n","name":"firestore.rules"}]},"createTime":"2026-03-03T20:08:33.468415Z","metadata":{"services":["cloud.firestore"]}}
