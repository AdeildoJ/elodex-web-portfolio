[debug] [2026-04-26T04:44:21.784Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/elodex-1c8a1/rulesets {"name":"projects/elodex-1c8a1/rulesets/a4a63173-c82a-40c1-9852-b3411e7163d8","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // ================================\n    // ðŸ”§ Helpers\n    // ================================\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isSelf(uid) {\n      return request.auth != null && request.auth.uid == uid;\n    }\n\n    function isAdmin() {\n      return request.auth != null && request.auth.token.admin == true;\n    }\n\n    // ================================\n    // ðŸ”¥ POKÃ‰DEX ADMIN\n    // ================================\n\n    // EspÃ©cies base dos PokÃ©mon (Biblioteca)\n    match /pokemonSpecies/{id} {\n      allow read:  if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    // ConfiguraÃ§Ãµes mutÃ¡veis de venda dos itens (loja)\n    match /itemsConfig/{id} {\n      allow read:  if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    // ConfiguraÃ§Ãµes por versÃ£o do jogo\n    match /pokedexConfig/{id} {\n      allow read:  if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    // Configuracao de encontros por bioma (definida no Pokedex/Admin)\n    match /biomeEncounterConfig/{id} {\n      allow read: if isSignedIn();\n      allow write: if isAdmin();\n\n      // Subcolecoes por bioma: /groups e /individual\n      match /{document=**} {\n        allow read: if isSignedIn();\n        allow write: if isAdmin();\n      }\n    }\n\n    // Cadastro de biomas (admin/web)\n    match /biomes/{id} {\n      allow read: if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    // Rotas entre biomas (acesso: KM, ticket, requisitos)\n    match /biomeRoutes/{id} {\n      allow read: if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    // Regras dinâmicas de evolução configuradas pelo admin/web\n    match /evolutionConfigRules/{id} {\n      allow read: if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    // Cadastro de NPCs (admin/web)\n    match /npcs/{id} {\n      allow read: if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    // Cadastro de cenarios (admin/web)\n    match /scenarios/{id} {\n      allow read: if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    // Cadastro de insignias (admin/web)\n    match /badges/{id} {\n      allow read: if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    // Pool global de Pokemon liberados/abandonados para re-encontro em biomas\n    match /releasedPokemonPool/{id} {\n      allow read: if isSignedIn();\n      allow create: if isSignedIn() && request.resource.data.sourceUid == request.auth.uid;\n      allow update: if isAdmin() || (\n        isSignedIn() &&\n        resource.data.status == \"active\" &&\n        request.resource.data.status == \"captured\"\n      );\n      allow delete: if isAdmin();\n    }\n\n    // Grupos de captura (configuracao coletiva)\n    match /captureConfigGroups/{id} {\n      allow read: if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    // Movimentos (catÃ¡logo geral de golpes)\n    match /moves/{id} {\n      allow read:  if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    // Learnset por espÃ©cie\n    match /pokemonMoves/{id} {\n      allow read:  if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    // Habilidades\n    match /abilities/{id} {\n      allow read:  if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    // Itens globais (CatÃ¡logo)\n    match /items/{id} {\n      allow read:  if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    match /vipPlans/{id} {\n      allow read: if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    match /monetizationProducts/{id} {\n      allow read: if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    match /ecoinPackages/{id} {\n      allow read: if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    match /gyms/{gymId} {\n      allow read: if isAdmin() || isSignedIn();\n      allow create: if isSignedIn() && gymId == request.auth.uid && request.resource.data.ownerUid == request.auth.uid;\n      allow update, delete: if isAdmin() || (isSignedIn() && gymId == request.auth.uid);\n\n      match /storage/{entryId} {\n        allow read: if isAdmin() || isSignedIn();\n        allow write: if isAdmin() || (isSignedIn() && gymId == request.auth.uid);\n      }\n\n      match /mainTeam/{entryId} {\n        allow read: if isAdmin() || isSignedIn();\n        allow write: if isAdmin() || (isSignedIn() && gymId == request.auth.uid);\n      }\n\n      match /{document=**} {\n        allow read: if isAdmin() || (isSignedIn() && gymId == request.auth.uid);\n        allow write: if isAdmin() || (isSignedIn() && gymId == request.auth.uid);\n      }\n    }\n\n    match /gymNames/{nameId} {\n      allow read: if isAdmin() || isSignedIn();\n      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;\n      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);\n    }\n\n    // ================================\n    // ðŸ”¥ ELODEX â€” USUÃRIOS\n    // ================================\n\n    // Perfil e dados do app mobile\n    match /players/{uid} {\n      allow read:  if isSelf(uid) || isAdmin();\n      allow write: if isSelf(uid) || isAdmin();\n\n      // Todas as subcolecoes: characters, box, time, itens, pokeballs, etc.\n      match /{document=**} {\n        allow read:  if isSelf(uid) || isAdmin();\n        allow write: if isSelf(uid) || isAdmin();\n      }\n    }\n\n    match /players/{uid}/monetizationHistory/{entryId} {\n      allow read: if isSelf(uid) || isAdmin();\n      allow write: if isSelf(uid) || isAdmin();\n    }\n\n    match /players/{uid}/productEntitlements/{entryId} {\n      allow read: if isSelf(uid) || isAdmin();\n      allow write: if isSelf(uid) || isAdmin();\n    }\n\n    match /users/{uid} {\n      allow read:  if isSelf(uid) || isAdmin();\n      allow write: if isSelf(uid) || isAdmin();\n    }\n\n    // HistÃ³rico financeiro principal (por usuÃ¡rio)\n    match /users/{uid}/transactions/{txId} {\n      allow read:  if isSelf(uid) || isAdmin();\n      allow write: if isSelf(uid) || isAdmin();\n    }\n\n    // âœ… collectionGroup(transactions) para admin\n    match /{path=**}/transactions/{txId} {\n      allow read: if isAdmin();\n    }\n\n    // Time principal\n    match /users/{uid}/team/{slotId} {\n      allow read:  if isSelf(uid) || isAdmin();\n      allow write: if isSelf(uid) || isAdmin();\n    }\n\n    // Box de armazenamento\n    match /users/{uid}/box/{boxEntryId} {\n      allow read:  if isSelf(uid) || isAdmin();\n      allow write: if isSelf(uid) || isAdmin();\n    }\n\n    // InventÃ¡rio de itens do jogador\n    match /users/{uid}/inventory/{itemId} {\n      allow read:  if isSelf(uid) || isAdmin();\n      allow write: if isSelf(uid) || isAdmin();\n    }\n\n    // HistÃ³rico econÃ´mico\n    match /users/{uid}/economy/{eventId} {\n      allow read:  if isSelf(uid) || isAdmin();\n      allow write: if isSelf(uid) || isAdmin();\n    }\n\n    // HistÃ³rico por PokÃ©mon\n    match /users/{uid}/pokemonHistory/{histId} {\n      allow read:  if isSelf(uid) || isAdmin();\n      allow write: if isSelf(uid) || isAdmin();\n    }\n\n    // ================================\n    // ðŸ”¥ INSTÃ‚NCIAS DE POKÃ‰MON\n    // ================================\n    match /pokemonInstances/{pokeInstanceId} {\n      allow read: if (isSignedIn() && isSelf(resource.data.ownerId)) || isAdmin();\n      allow write: if (isSignedIn() && isSelf(request.resource.data.ownerId)) || isAdmin();\n    }\n\n    // ================================\n    // ðŸ”¥ ESTATÃSTICAS\n    // ================================\n    match /users_stats/{uid} {\n      allow read:  if isSelf(uid) || isAdmin();\n      allow write: if isSelf(uid) || isAdmin();\n    }\n\n    match /pokemon_stats/{pokeId} {\n      allow read:  if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    // ================================\n    // ðŸ”¥ LOGS / MISSÃ•ES / EVENTOS\n    // ================================\n\n    match /encounters_log/{id} {\n      allow read:  if false;\n      allow write: if isSignedIn();\n    }\n\n    // âœ… CONFIGURAÃ‡ÃƒO ADMIN (NOVO) â€” MissÃµes & Eventos (Admin)\n    // ColeÃ§Ã£o unificada apenas para CONFIGURAÃ‡ÃƒO\n    // (nÃ£o Ã© execuÃ§Ã£o de jogo)\n    match /missionsEvents/{id} {\n      allow read:  if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    // ColeÃ§Ãµes antigas (se vocÃª ainda usa em algum lugar)\n    match /missions/{id} {\n      allow read:  if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    match /events/{id} {\n      allow read:  if isSignedIn();\n      allow write: if isAdmin();\n    }\n\n    match /audit_logs/{id} {\n      allow read:  if isAdmin();\n      allow write: if isAdmin();\n    }\n\n    // ================================\n    // ðŸ”¥ PRESENÃ‡A (futuro)\n    // ================================\n    match /presence/{uid} {\n      allow read:  if isSignedIn();\n      allow write: if false;\n    }\n\n    // BATTLE SYSTEM\n    match /battlePresence/{id} {\n      allow read: if isSignedIn();\n      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;\n      allow delete: if isAdmin();\n    }\n\n    match /battleInvites/{id} {\n      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;\n\n      allow read: if isAdmin() || (isSignedIn() && (\n        resource.data.fromUid == request.auth.uid ||\n        resource.data.toUid == request.auth.uid\n      ));\n\n      allow update: if isAdmin() || (isSignedIn() && (\n        (resource.data.toUid == request.auth.uid && request.resource.data.status in [\"accepted\", \"declined\"]) ||\n        (resource.data.fromUid == request.auth.uid && request.resource.data.status == \"canceled\")\n      ));\n\n      allow delete: if isAdmin();\n    }\n\n    match /battleRooms/{id} {\n      allow read: if isSignedIn();\n      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;\n      allow update: if isAdmin() || (isSignedIn() && (\n        resource.data.ownerUid == request.auth.uid ||\n        resource.data.challengerUid == request.auth.uid ||\n        (resource.data.status == \"waiting_opponent\" && request.resource.data.challengerUid == request.auth.uid)\n      ));\n      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-04-26T04:44:20.694879Z","metadata":{"services":["cloud.firestore"]}}
